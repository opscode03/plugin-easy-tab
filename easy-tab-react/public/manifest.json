{
  "manifest_version": 3,
  "name": "Easy Tab · 轻量新标签页",
  "version": "1.0.0",
  "description": "使用 React 构建的轻量新标签页，提供时间、搜索和常用入口。",
  "permissions": ["storage", "bookmarks", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
